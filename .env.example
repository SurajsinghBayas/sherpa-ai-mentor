# ─────────────────────────────────────────────────────────────────────────────
# Sherpa AI Codebase Mentor — environment config
# Copy this file to .env and fill in values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Auth (required) ───────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=dev-only-change-me-in-production

# Token expiry in minutes (default 1440 = 24h)
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ─────────────────────────────────────────────────────────────────
# Leave blank for local SQLite (zero setup, great for dev).
# Set to a Neon Postgres URL for production — see docs/neon_setup.md
# DATABASE_URL=postgresql+psycopg://user:pass@ep-xxx.neon.tech/sherpa?sslmode=require

# ── Credential encryption ─────────────────────────────────────────────────────
# Required in production to encrypt users' stored API keys.
# Generate: python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# ENCRYPTION_KEY=

# ── Default server-side LLM ───────────────────────────────────────────────────
# Sherpa ships with Bedrock Mantle as the default LLM provider.
# Users do NOT need to bring their own API keys.
# The values below are pre-configured; override in .env if needed.
LLM_PROVIDER=openai
LLM_MODEL=deepseek.v3.2
OPENAI_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
OPENAI_PROJECT_ID=default
# OPENAI_API_KEY=<your-bedrock-mantle-key>

# ── Alternative LLM providers (BYOK) ─────────────────────────────────────────
# Users can also add their own keys via the Settings UI.
# These are server-side fallbacks if you want a different default.
#
# OpenAI:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...
#
# Anthropic:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=sk-ant-...
#
# OpenRouter (many models, one key):
# LLM_PROVIDER=openrouter
# LLM_MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=sk-or-...
#
# Ollama (fully local):
# LLM_PROVIDER=ollama
# LLM_MODEL=codellama
# OLLAMA_BASE_URL=http://localhost:11434

# ── Web enrichment (optional) ─────────────────────────────────────────────────
# Enables scraping the GitHub repo page + your docs URLs as cited web chunks.
# Blank = code-only answers (still works great without this).
# FIRECRAWL_API_KEY=fc-...
# FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# ── CORS (production) ─────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Default (dev): http://localhost:3000,http://127.0.0.1:3000
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Requests per minute per IP per endpoint.
# RATE_LIMIT_PER_MINUTE=60

# ── Request body size ─────────────────────────────────────────────────────────
# Max body in bytes. Default 1 MB.
# MAX_BODY_BYTES=1048576

# ── Local Postgres (docker compose) ──────────────────────────────────────────
# DATABASE_URL=postgresql+psycopg://sherpa:sherpa@localhost:5432/sherpa
