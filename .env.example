# local demo (SQLite, no keys needed)
LLM_PROVIDER=none
LLM_MODEL=offline
JWT_SECRET_KEY=dev-only-change-me
DATA_DIR=./data

# hosted models (server default; users can also bring their own via Settings UI)
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# production database (Neon Postgres) — see docs/neon_setup.md
# DATABASE_URL=postgresql+psycopg://user:pass@ep-xxx.neon.tech/sherpa?sslmode=require
# ENCRYPTION_KEY=<output of: python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'>

# local postgres via docker compose:
# DATABASE_URL=postgresql+psycopg://sherpa:sherpa@localhost:5432/sherpa
