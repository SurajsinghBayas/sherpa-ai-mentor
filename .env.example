# ─────────────────────────────────────────────────────────────────────────────
# Sherpa AI Codebase Mentor — environment config
# Copy this file to .env and fill in values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment ───────────────────────────────────────────────────────────────
# production refuses to start without a strong JWT secret, a valid ENCRYPTION_KEY (Fernet,
# different from the JWT secret), a Postgres DATABASE_URL with SSL, https ALLOWED_ORIGINS,
# rate limits on and ALLOW_LOCAL_INGEST off. It also hides /api/docs, blocks custom LLM
# endpoints on private/internal addresses, and refuses to show email codes in logs.
# ENVIRONMENT=production

# ── Auth (required) ───────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=dev-only-change-me-in-production

# Token expiry in minutes (default 1440 = 24h)
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ─────────────────────────────────────────────────────────────────
# Leave blank for local SQLite (zero setup; search uses TF-IDF).
# Set to AWS RDS Postgres for production — accounts, repos, chunks and pgvector embeddings live here.
# Migrations run automatically on startup. See docs/rds_setup.md
# DATABASE_URL=postgresql+psycopg://postgres:<password>@<instance>.<region>.rds.amazonaws.com:5432/postgres?sslmode=require

# ── Credential encryption ─────────────────────────────────────────────────────
# Required in production to encrypt users' stored API keys.
# Generate: python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# ENCRYPTION_KEY=

# ── Default server-side LLM ───────────────────────────────────────────────────
# Sherpa ships with Bedrock Mantle as the default LLM provider.
# Users do NOT need to bring their own API keys.
# The values below are pre-configured; override in .env if needed.
LLM_PROVIDER=openai
# Kimi K2.5 gave the best-cited, best-formatted answers in our benchmark (see README).
LLM_MODEL=moonshotai.kimi-k2.5
# Tried in order if the main model errors (each fallback is logged):
LLM_FALLBACK_MODELS=qwen.qwen3-coder-480b-a35b-instruct,deepseek.v3.2
OPENAI_BASE_URL=https://bedrock-mantle.ap-south-1.api.aws/v1
OPENAI_PROJECT_ID=default
# OPENAI_API_KEY=<your-bedrock-mantle-key>

# ── Alternative LLM providers (BYOK) ─────────────────────────────────────────
# Users can also add their own keys via the Settings UI.
# These are server-side fallbacks if you want a different default.
#
# OpenAI:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...
#
# Anthropic:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=sk-ant-...
#
# OpenRouter (many models, one key):
# LLM_PROVIDER=openrouter
# LLM_MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=sk-or-...
#
# Ollama (fully local):
# LLM_PROVIDER=ollama
# LLM_MODEL=codellama
# OLLAMA_BASE_URL=http://localhost:11434

# ── Local folder ingest (dev only) ────────────────────────────────────────────
# Lets /api/ingest read a folder on the API server (`make api` turns this on).
# Never enable on a shared/production server: it exposes that folder's files.
# ALLOW_LOCAL_INGEST=true

# ── CORS (production) ─────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Default (dev): http://localhost:3000,http://127.0.0.1:3000
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# The desktop app's origins are allowed separately (default shown; empty disables the desktop app):
# DESKTOP_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Requests per minute per user (or IP) per endpoint. Sign-in routes have fixed, stricter
# per-IP limits. Counters are per instance (with N replicas the effective limit is N×).
# RATE_LIMIT_PER_MINUTE=60

# ── Ingest limits ─────────────────────────────────────────────────────────────
# MAX_CONCURRENT_INGESTS=3      # per instance; more → 503 "busy", one import per user at a time
# MAX_REPO_MB=500               # clone size cap
# CLONE_TIMEOUT_SECONDS=180

# ── Uploads (ZIP / folder / CLI) ──────────────────────────────────────────────
# MAX_UPLOAD_MB=100             # uploaded ZIP size
# MAX_UPLOAD_SOURCE_MB=50       # text kept after filtering (what gets indexed)

# ── LLM ───────────────────────────────────────────────────────────────────────
# LLM_TIMEOUT_SECONDS=90        # per model call (each fallback gets its own)

# ── Per-user daily quotas (UTC) ───────────────────────────────────────────────
# DAILY_LLM_REQUESTS=300
# DAILY_INGESTS=30
# MAX_REPOS_PER_USER=15

# ── Request body size ─────────────────────────────────────────────────────────
# Max body in bytes. Default 1 MB.
# MAX_BODY_BYTES=1048576

# ── Local Postgres (docker compose) ──────────────────────────────────────────
# DATABASE_URL=postgresql+psycopg://sherpa:sherpa@localhost:5432/sherpa

# ── Embeddings (Amazon Bedrock) ───────────────────────────────────────────────
# Bedrock API key from the Bedrock console. Used only with Postgres (pgvector);
# blank → keyword + TF-IDF search. If your shell profile exports a different
# AWS_BEARER_TOKEN_BEDROCK it wins over this file — `make api` unsets it for you.
AWS_BEARER_TOKEN_BEDROCK=
AWS_DEFAULT_REGION=us-east-1

# Spoken explanations with Amazon Polly. Needs an IAM user/role allowed polly:SynthesizeSpeech
# (the Bedrock API key above can't sign Polly calls). Leave the keys blank to use ~/.aws or a role;
# with no credentials at all the app speaks with the browser's built-in voice instead.
POLLY_ACCESS_KEY_ID=
POLLY_SECRET_ACCESS_KEY=
POLLY_REGION=
POLLY_VOICE=Ruth
# neural answers fast enough for live conversation; generative is richer but ~4x slower to start
POLLY_ENGINE=neural
EMBEDDING_MODEL=amazon.nova-2-multimodal-embeddings-v1:0
# EMBEDDING_CONCURRENCY=16

# ── Sign-in: email one-time codes ─────────────────────────────────────────────
# Gmail: turn on 2-Step Verification, then create an App password
# (Google Account → Security → App passwords). Without SMTP, dev servers log codes instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=Sherpa AI

# ── Sign-in: Google ──────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized JavaScript origins: http://localhost:3000 (+ your production web URL).
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
